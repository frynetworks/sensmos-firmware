# Copy to .env and edit. Every value here is the default the container already uses,
# so an empty .env is a working configuration.

# ── Mode ──────────────────────────────────────────────────────────────────────
# firmware  full node protocol: self-registration, encrypted WebSocket, signed batches.
#           The node appears under SENSMOS_WALLET.
# ingest    software-node mode: plain POST /v1/ingest with a passkey. Simpler, but the
#           node is NOT linked to any wallet and earns nothing.
SENSMOS_MODE=firmware

# ── Identity and ownership (firmware mode) ────────────────────────────────────
# The Sensmos account the node registers under.
SENSMOS_WALLET=0x6403bdF454Ed25502378f231CB656C698Cb74d78

# Where the secp256k1 private key is stored. Keep this on a volume — losing it means
# losing the node's identity, and the node will register again as a brand new device.
SENSMOS_KEY_PATH=/data/node.key

# Optional. Pins the MAC used in the device_id derivation. Leave unset: the value is
# detected once and then persisted next to the key, which is what keeps the identity
# stable across `docker compose down && up` (Docker assigns a new MAC each time).
#SENSMOS_MAC=

# Cosmetic, shown in logs and used as the ingest label.
SENSMOS_NODE_NAME=docker-node

# Version string reported to the backend.
SENSMOS_FIRMWARE=0.1.0-docker

# ── Endpoints ─────────────────────────────────────────────────────────────────
SENSMOS_API_URL=https://api.sensmos.com/v1
# The firmware uses plaintext WebSocket on port 80; the payload layer is encrypted
# independently (AES-128-GCM over an ECDH session key), so TLS is not what protects it.
SENSMOS_WS_URL=ws://api.sensmos.com:80/v1/ws

# ── Cadence (seconds) ─────────────────────────────────────────────────────────
# Firmware defaults: batch no more often than 60 s, forced at 180 s.
SENSMOS_INTERVAL_SEC=60
SENSMOS_FORCE_INTERVAL_SEC=180
SENSMOS_MON_INTERVAL_SEC=180
SENSMOS_PING_INTERVAL_SEC=60

# ── Data ──────────────────────────────────────────────────────────────────────
# A container has no sensors. With this on, the node publishes generated readings for
# whichever entity names the backend calls native. Turn it off and only real container
# metrics (uptime, load, free memory) are reported.
SENSMOS_SIMULATE=true

# Optional map position. Both or neither.
#SENSMOS_LAT=44.0
#SENSMOS_LON=-92.5

# ── Ingest mode only ──────────────────────────────────────────────────────────
# Minimum 32 characters. device_id = sha256("sensmos-soft:" + key).
#SENSMOS_INGEST_KEY=

# ── Operational ───────────────────────────────────────────────────────────────
SENSMOS_HEALTH_PORT=8080
# Host binding for the health endpoint. Loopback by default — do not expose it publicly.
SENSMOS_HEALTH_BIND=127.0.0.1:18080
SENSMOS_LOG_LEVEL=info
SENSMOS_MAX_CLOCK_SKEW_SEC=120
